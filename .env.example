# ─── RuleXMC website configuration ────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rulexmc?schema=public"

# Public site URL (used for Stripe redirects, sitemap, metadata)
SITE_URL="http://localhost:3000"
SITE_NAME="RuleX MC"

# ─── Minecraft server ─────────────────────────────────────────────────────────
# Java server address shown on the site and used for live status ("host" or "host:port").
# Set to an empty string to hide it ("Server address not configured").
MC_SERVER_ADDRESS="rulexmc.mcsh.io"
# Supported client versions shown on the site. Empty = the verified default "1.9 – 26.2+" (src/lib/site.ts).
MC_VERSION_LABEL=""
# Live status source: "mcsrvstat" (https://api.mcsrvstat.us, default) or "ping" (direct Server List Ping from this server)
STATUS_SOURCE="mcsrvstat"
STATUS_CACHE_SECONDS="60"

# ─── Player stats ─────────────────────────────────────────────────────────────
# "database" = PlayerStats table filled by POST /api/ingest/stats (live)
# "sample"   = generated SAMPLE DATA for development (always badged as sample)
STATS_PROVIDER="database"
# Shared secret the game server uses for /api/ingest/* (Authorization: Bearer <secret>). Min 32 chars.
# Generate: openssl rand -hex 32
INGEST_SECRET=""

# ─── Payments ─────────────────────────────────────────────────────────────────
# "none" (buttons disabled: "Payments not configured"), "tebex" or "stripe"
PAYMENT_PROVIDER="none"
STORE_CURRENCY="USD"
# Stripe (only if PAYMENT_PROVIDER=stripe) — server-side only, never exposed to the browser
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Tebex: set a per-item checkout URL on each listing in /admin/store (no key needed here)

# ─── Community links (leave empty to hide) ────────────────────────────────────
# DISCORD_URL: unset = the official invite (https://discord.com/invite/aBg5Wrp4U4); "" = hide Discord.
# DISCORD_URL=""
YOUTUBE_URL=""
TIKTOK_URL=""
X_URL=""
# VOTE_URL: optional extra vote link shown first (the verified server-list pages in src/lib/site.ts are always shown).
VOTE_URL=""

# ─── Misc ─────────────────────────────────────────────────────────────────────
# "postgres" (default, multi-instance safe) or "memory" (single instance only)
RATE_LIMIT_STORE="postgres"
# First admin (used by `npm run admin:create` if no --email/--password args are passed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# docker-compose only: password for the bundled PostgreSQL container
POSTGRES_PASSWORD=""
